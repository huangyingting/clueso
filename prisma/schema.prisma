generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String              @id @default(cuid())
  email                     String              @unique
  name                      String
  firstName                 String?
  lastName                  String?
  passwordHash              String?
  pictureUrl                String?
  role                      String              @default("Admin")
  status                    String              @default("active")
  emailVerified             DateTime?
  sessionVersion            Int                 @default(1)
  organizationId            String
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts                  Account[]
  sessions                  Session[]
  passwordCredential        PasswordCredential?
  guides                    Guide[]
  comments                  Comment[]
  chatThreads               ChatThread[]
  accountInvitationsSent     AccountInvitation[] @relation("AccountInvitationInviter")
  accountInvitationsAccepted AccountInvitation[] @relation("AccountInvitationAcceptor")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  resetTokenHash    String?   @unique
  resetExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                  String                 @id @default(cuid())
  name                String
  domain              String                 @default("acme.io")
  logoUrl             String?
  plan                String                 @default("Enterprise")
  region              String                 @default("usw1")
  openDoor            Boolean                @default(true)
  aiCreditsRemaining  Int                    @default(48200)
  aiCreditsTotal      Int                    @default(50000)
  seatsPurchased      Int                    @default(25)
  mcpConnected        Boolean                @default(true)
  brandKitJson        String                 @default("{}")
  videoDefaultsJson   String                 @default("{}")
  playerConfigJson    String                 @default("{}")
  viewOnlyConfigJson  String                 @default("{}")
  integrationsJson    String                 @default("{}")
  providersJson       String                 @default("{}")
  users               User[]
  folders             Folder[]
  guides              Guide[]
  clueprints          Clueprint[]
  pronunciations      PronunciationRule[]
  transcriptionWords  TranscriptionKeyword[]
  translationGlossary TranslationTerm[]
  chatThreads         ChatThread[]
  invitations         AccountInvitation[]
  aiInvocations       AiInvocation[]
  auditLogs           AuditLog[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model Folder {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  isDeleted      Boolean      @default(false)
  guides         Guide[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Guide {
  id             String         @id @default(cuid())
  name           String
  description    String?
  status         String         @default("published")
  activeFormat   String         @default("video")
  languageId     String         @default("en")
  duration       Float          @default(18.5)
  aspectRatio    String         @default("16:9")
  tagsJson       String         @default("[]")
  guideDataJson  String
  updateId       Int            @default(1)
  isDeleted      Boolean        @default(false)
  folderId       String?
  folder         Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  versions       GuideVersion[]
  comments       Comment[]
  exports        GuideExport[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model GuideVersion {
  id            String   @id @default(cuid())
  guideId       String
  guide         Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  versionNumber Int
  name          String
  guideDataJson String
  authorName    String
  createdAt     DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  timestamp Float    @default(0)
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GuideExport {
  id          String   @id @default(cuid())
  guideId     String
  guide       Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  processType String   @default("export")
  format      String   @default("mp4")
  resolution  String   @default("1080p")
  status      String   @default("completed")
  downloadUrl String
  createdAt   DateTime @default(now())
}

model Clueprint {
  id             String       @id @default(cuid())
  name           String
  description    String
  category       String       @default("Workspace")
  aspectRatio    String       @default("16:9")
  duration       Float        @default(15)
  templateJson   String       @default("{}")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model ChatThread {
  id             String       @id @default(cuid())
  title          String
  model          String       @default("Opus 5.5")
  guideId        String?
  messagesJson   String       @default("[]")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PronunciationRule {
  id             String       @id @default(cuid())
  word           String
  phonetic       String
  language       String       @default("English (US)")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model TranscriptionKeyword {
  id             String       @id @default(cuid())
  keyword        String
  category       String       @default("Brand")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model TranslationTerm {
  id             String       @id @default(cuid())
  term           String
  doNotTranslate Boolean      @default(true)
  translations   String       @default("{}")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model AccountInvitation {
  id              String       @id @default(cuid())
  email           String
  normalizedEmail String
  activeForEmail  String?      @unique
  tokenHash       String?      @unique
  status          String       @default("PENDING")
  role            String       @default("Editor")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById     String?
  invitedBy       User?        @relation("AccountInvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedById    String?
  acceptedBy      User?        @relation("AccountInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  emails          AccountEmailOutbox[]

  @@index([status, expiresAt])
  @@index([normalizedEmail, createdAt])
  @@index([organizationId])
}

model AccountEmailOutbox {
  id            String             @id @default(cuid())
  payload       String
  status        String             @default("pending")
  claimToken    String?
  lastAttemptAt DateTime?
  lastError     String?
  sentAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime           @default(now())
  invitationId  String?
  invitation    AccountInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invitationId])
}

model AiInvocation {
  id               String       @id @default(cuid())
  feature          String
  provider         String       @default("azure-openai")
  model            String       @default("gpt-6.1-sol")
  status           String       @default("ok")
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  totalTokens      Int          @default(0)
  durationMs       Int          @default(0)
  estimatedCostUsd Float        @default(0)
  userId           String?
  guideId          String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([feature, createdAt])
}

model SpeechSynthesisAsset {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  guideId     String?
  clipId      String?
  voiceName   String
  language    String   @default("en-US")
  text        String
  mimeType    String   @default("audio/mpeg")
  audioBase64 String
  wordsJson   String   @default("[]")
  durationMs  Int      @default(0)
  provider    String   @default("azure")
  createdAt   DateTime @default(now())

  @@index([guideId])
}

model AuditLog {
  id             String       @id @default(cuid())
  action         String
  actorId        String?
  actorEmail     String?
  actorRole      String?
  targetType     String
  targetId       String?
  metadataJson   String       @default("{}")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}
