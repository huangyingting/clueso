# Local development (SQLite)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
PRISMA_SCHEMA_PATH="prisma/schema.prisma"

# Account Admission Policy (invitation-only by default, matching ReadWise; or public)
ACCOUNT_ADMISSION_MODE="invitation-only"
ACCOUNT_ADMISSION_RETENTION_DAYS="90"

# Bootstrap Administrator (optional auto-bootstrap on startup or setup token for /admin/bootstrap)
BOOTSTRAP_ADMIN_EMAIL="alex@acme.io"
BOOTSTRAP_ADMIN_NAME="Alex Rivera"
# BOOTSTRAP_ADMIN_PASSWORD="change-me-in-production"
BOOTSTRAP_ADMIN_TOKEN="clueso-bootstrap-admin-2026"

# OAuth Providers (optional linked sign-in methods)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_TENANT_ID="your-tenant-id-or-common"

# Azure OpenAI (powers AI Script Rewrite, Magic Translate, Clueso AI Co-Pilot, Guide Gen, SOP Article Enhance)
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-6.1-sol"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_OUTPUT_TOKENS="4096"
AI_LEDGER_ENABLED="true"

# Azure Speech (powers Neural TTS voiceovers with word-boundary timings)
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="japaneast"
AZURE_SPEECH_VOICE="en-US-AndrewMultilingualNeural"
AZURE_SPEECH_OUTPUT_FORMAT="audio-24khz-96kbitrate-mono-mp3"
AZURE_BATCH_SYNTHESIS_ENDPOINT="https://japaneast.tts.speech.microsoft.com"
SPEECH_TIMEOUT_MS="30000"

# Production deployment (PostgreSQL)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clueso?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="clueso-studio-super-secret-key-2026"
